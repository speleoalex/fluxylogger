# ---------------------------------------------------------------------------
# GitHub Linguist configuration
# The language statistics cover the code actually developed here: the
# Arduino/C++ firmware and the HTML/JS web viewer. Documentation, example
# data, drawings, legacy/test code and IDE metadata are excluded.
# ---------------------------------------------------------------------------

# Arduino sketches are C++
*.ino  linguist-language=C++
*.h    linguist-language=C++

# Firmware is always counted
FluxyLogger/**              linguist-detectable=true

# Web viewer application: part of the project, counted as HTML/JS.
# The bundled loggerviewer.js embeds a minified Chart.js copy, so it is
# marked as vendored and kept out of the statistics.
LoggerViewer_Web/loggerviewer.js  linguist-vendored
LoggerViewer_Web_Legacy/**        linguist-detectable=false

# Experiments / test sketches
tests/**                    linguist-detectable=false
Datalogger_TestMinimal/**   linguist-detectable=false

# Documentation and manuals
doc/**                      linguist-documentation
manuals/**                  linguist-documentation
*.md                        linguist-documentation

# Data, drawings and IDE metadata
example_logs/**             linguist-detectable=false
drawings/**                 linguist-detectable=false
media/**                    linguist-detectable=false
nbproject/**                linguist-generated=true
.vscode/**                  linguist-generated=true
